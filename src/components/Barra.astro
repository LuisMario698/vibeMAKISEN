---
import Idioma from './Idioma.astro';
import { menu } from '../data/schema';
const primeraBebida = menu.categorias.find((c) => c.grupo === 'bebidas')?.id;
---
<div id="centinela" class="h-px" aria-hidden="true"></div>
<nav class="barra sticky top-0 z-30 border-b border-white/10 bg-noche/80 backdrop-blur-xl transition-shadow duration-500" aria-label="Categorías del menú">
  <div class="flex h-[60px] items-center gap-2 px-3">
    <a href="#inicio" class="barra-logo tap grid w-11 shrink-0 place-items-center" aria-label="Volver arriba">
      <img src="/brand/logo-isotipo.png" width="36" height="36" alt="" class="size-9 rounded-full" />
    </a>
    <form role="search" class="buscador relative min-w-0 flex-1" onsubmit="return false">
      <svg class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-humo" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="buscar" type="search" inputmode="search" autocomplete="off" enterkeyhint="search"
        class="h-11 w-full rounded-full border border-white/15 bg-pizarra/80 pr-3 pl-9 text-[16px] text-hueso placeholder:text-humo transition-[border-color,box-shadow] duration-300 focus:border-oro focus:shadow-[0_0_0_4px_rgb(174_139_61/0.18)] focus:outline-none"
        placeholder="Buscar…" aria-label="Buscar en el menú" />
    </form>
    <Idioma class="shrink-0" />
  </div>
  <div class="chips relative overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <ul class="relative flex w-max items-center gap-1 px-3 pb-2.5">
      <li aria-hidden="true" class="indicador pointer-events-none absolute top-0 left-0 h-11 w-0 rounded-full bg-hueso"></li>
      {menu.categorias.map((c) => (
        <>
          {c.id === primeraBebida && (
            <li aria-hidden="true" class="px-2 font-alt text-[11px] uppercase tracking-[0.25em] text-oro">
              <span lang="es">Bebidas</span><span lang="en">Drinks</span>
            </li>
          )}
          <li>
            <a href={`#${c.id}`} data-chip={c.id} class="chip presionable relative z-10 flex h-11 items-center rounded-full px-4 text-[15px] font-semibold whitespace-nowrap text-niebla transition-colors duration-300 hover:text-hueso aria-[current=true]:text-noche">
              <span lang="es">{c.nombre.es}</span><span lang="en">{c.nombre.en}</span>
            </a>
          </li>
        </>
      ))}
    </ul>
  </div>
</nav>
