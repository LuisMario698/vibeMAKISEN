---
// "Lo más pedido": carrusel con fotos reales de sus redes. Cada carta abre el detalle.
import { menu } from '../data/schema';
import { destacados, foto } from '../data/fotos-reales';
import { precio } from '../lib/etiquetas';

const todos = menu.categorias.flatMap((c) => c.platillos.map((p) => ({ ...p, cat: c.nombre })));
const items = destacados.map((d) => ({ ...todos.find((p) => p.id === d.id)!, f: foto(d.foto) }));
const titulo = (t: string) => t.split(' ').map((w, i) => `<span class="pal"><span style="--w:${i}">${w}</span></span>`).join(' ');
---
<section class="pt-16" aria-labelledby="t-destacados">
  <div class="revela mx-auto max-w-5xl px-4">
    <p class="ceja"><span lang="es">Lo que más piden</span><span lang="en">Most ordered</span></p>
    <h2 id="t-destacados" class="mt-2 text-[34px] leading-[1.05] font-bold sm:text-[44px]">
      <span lang="es" set:html={titulo('Imprescindibles de la casa')} /><span lang="en" set:html={titulo('House must-haves')} />
    </h2>
    <p class="mt-3 max-w-md text-[15px] text-niebla">
      <span lang="es">Lo más mencionado por quienes ya nos visitaron. Fotos reales de nuestras redes.</span>
      <span lang="en">What our guests talk about the most. Real photos from our social media.</span>
    </p>
  </div>
  <ul class="carril mt-7 flex snap-x snap-mandatory gap-4 overflow-x-auto px-[12vw] pb-4 sm:px-[calc(50vw-170px)]">
    {items.map((p, i) => (
      <li class="carta w-[76vw] max-w-[340px] shrink-0 snap-center">
        <article class="relative aspect-[3/4] overflow-hidden rounded-[30px] border border-oro/30 bg-pizarra">
          <img src={p.f.src} width={p.f.w} height={p.f.h} alt="" loading="lazy" decoding="async" data-foto={p.id} class="carta-img absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.35),transparent_30%,transparent_45%,rgb(0_0_0/0.92))]"></div>
          <p class="absolute top-4 left-5 font-alt text-[12px] tracking-[0.3em] text-oro-claro" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <p class="font-alt text-[11px] tracking-[0.24em] text-oro-claro uppercase"><span lang="es">{p.cat.es}</span><span lang="en">{p.cat.en}</span></p>
            <h3 class="mt-1 text-[24px] leading-tight font-bold">
              <button type="button" data-abrir={p.id} aria-haspopup="dialog" class="text-left after:absolute after:inset-0 after:rounded-[30px] after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-oro-claro">
                <span lang="es">{p.nombre.es}</span><span lang="en">{p.nombre.en}</span>
              </button>
            </h3>
            <div class="mt-3 flex items-center justify-between">
              <p class="text-[20px] font-bold tabular-nums">{precio(p.precio)}</p>
              <span class="grid size-11 place-items-center rounded-full bg-oro text-noche" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
