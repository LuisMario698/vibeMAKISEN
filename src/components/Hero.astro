---
// Portada editorial: titular que entra letra por letra, «Sinaloa.» en hoja de oro con
// una ola de pincel (el Mar de Cortés) debajo, la cinta de especialidades y una sola
// foto real que se abre a pantalla completa al hacer scroll.
import '../styles/intro.css';
import { menu } from '../data/schema';
import { foto } from '../data/fotos-reales';

const n = menu.negocio;
const f = foto('fachada-dia');

// Titular dividido en palabras y letras. Cada letra lleva su turno (--k) para el escalonado;
// la palabra en oro entra completa, como hoja de oro que se extiende.
type Palabra = string | { oro: string };
const TITULAR: Record<'es' | 'en', { texto: string; renglones: Palabra[][] }> = {
  es: { texto: 'Sushi & mariscos estilo Sinaloa.', renglones: [['Sushi', '&', 'mariscos'], ['estilo', { oro: 'Sinaloa.' }]] },
  en: { texto: 'Sushi & seafood, Sinaloa style.', renglones: [['Sushi', '&', 'seafood'], [{ oro: 'Sinaloa' }, 'style.']] },
};
function armar(renglones: Palabra[][]) {
  let k = 0;
  return renglones.map((r) =>
    r.map((p) => {
      if (typeof p === 'string') return { oro: false as const, letras: [...p].map((c) => ({ c, k: k++ })) };
      const v = { oro: true as const, texto: p.oro, k };
      k += 3;
      return v;
    }),
  );
}
const titular = (['es', 'en'] as const).map((l) => ({ l, texto: TITULAR[l].texto, renglones: armar(TITULAR[l].renglones) }));

// Lo que más elogian las reseñas, más la mixología de la casa.
const ESPECIALIDADES = [
  { es: 'Camarón roca', en: 'Rock shrimp' },
  { es: 'Aguachiles', en: 'Aguachiles' },
  { es: 'Tostadas de atún', en: 'Tuna tostadas' },
  { es: 'Rollos sinaloenses', en: 'Sinaloa-style rolls' },
  { es: 'Mixología de la casa', en: 'House mixology' },
];
const vuelta = [...ESPECIALIDADES, ...ESPECIALIDADES];

// Ola de pincel (Mar de Cortés): trazos periódicos más anchos que la palabra; se desplazan un
// periodo en bucle. Periodo de 60 unidades = 0.6em (A) y 45 = 0.45em (B).
function ola(periodos: number, ancho: number, y: number, amp: number) {
  const m = ancho / 2;
  let d = `M0 ${y}C${ancho / 6} ${y - amp} ${ancho / 3} ${y - amp} ${m} ${y}`;
  for (let i = 0; i < periodos; i++) {
    const x = i * ancho;
    d += `S${x + ancho - ancho / 6} ${y + amp} ${x + ancho} ${y}`;
    if (i < periodos - 1) d += `S${x + ancho + m - ancho / 6} ${y - amp} ${x + ancho + m} ${y}`;
  }
  return d;
}
const olaA = ola(10, 60, 7.5, 4.6);
const olaB = ola(13, 45, 15.5, 2.4);
---
<section id="inicio" class="relative pt-[calc(4rem+env(safe-area-inset-top))]" aria-labelledby="t-inicio">
  <div class="hero-cont contenedor pt-7 sm:pt-14">
    <!-- Logotipo completo en grande: que se sepa de inmediato qué restaurante es. -->
    <div class="marca-hero aparece" style="--d:40">
      <img src="/brand/logo-horizontal.svg" width="891" height="349" alt="MAKIZEN Sushi & Mariscos" fetchpriority="high" decoding="async" class="marca-hero-img" />
      <span class="marca-brillo" aria-hidden="true"></span>
    </div>
    <p class="aparece ceja mt-3 !text-[11px] !tracking-[0.32em] text-hueso/70" style="--d:90">Puerto Peñasco · Sonora</p>
    <p data-estado-local class="aparece mt-6 inline-flex min-h-10 items-center gap-2.5 rounded-full vidrio px-4 text-[14px] ring-1 ring-white/[0.07]" style="--d:120" aria-live="polite">
      <span class="punto relative size-2 rounded-full text-abierto" style="background:currentColor"></span>
      <span class="texto"><span lang="es">Lun, Mié, Jue 1–9 pm · Vie a Dom 1–10 pm</span><span lang="en">Mon, Wed, Thu 1–9 pm · Fri–Sun 1–10 pm</span></span>
    </p>

    <h1 id="t-inicio" class="titular mt-6 text-[clamp(2.7rem,12.4vw,6.8rem)] leading-[0.98] font-semibold tracking-[-0.04em]">
      {titular.map((t) => <span class="sr-only" lang={t.l}>{t.texto}</span>)}
      {titular.map((t) => (
        <span class="titular-vista" lang={t.l} aria-hidden="true">
          {t.renglones.map((r, i) => (
            <span class="renglon" style={`--base:${i === 0 ? 160 : 300}`}>
              {r.map((p, j) => (
                <>
                  {j > 0 && ' '}
                  {p.oro ? (
                    <span class="palabra-oro" style={`--k:${p.k}`}>
                      <span class="oro">{p.texto}</span>
                      <span class="ola">
                        <svg class="ola-a" viewBox="0 0 600 20" preserveAspectRatio="none"><path d={olaA} /></svg>
                        <svg class="ola-b" viewBox="0 0 585 20" preserveAspectRatio="none"><path d={olaB} /></svg>
                      </span>
                    </span>
                  ) : (
                    <span class="palabra">{p.letras.map((x) => <span class="letra" style={`--k:${x.k}`}>{x.c}</span>)}</span>
                  )}
                </>
              ))}
            </span>
          ))}
        </span>
      ))}
    </h1>
    <p class="aparece mt-8 max-w-[30rem] text-[17px] leading-relaxed text-niebla sm:mt-10" style="--d:620">
      <span lang="es">Rollos, aguachiles y tostadas con sazón de Culiacán, en Puerto Peñasco, Sonora.</span>
      <span lang="en">Rolls, aguachiles and tostadas with Culiacán flavor, in Puerto Peñasco (Rocky Point), Sonora.</span>
    </p>
    <div class="aparece mt-7 flex flex-wrap gap-3" style="--d:720">
      <a href="#menu" class="boton-oro presionable">
        <span lang="es">Ver el menú</span><span lang="en">See the menu</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
      <a href={n.mapa} target="_blank" rel="noopener" class="boton-linea presionable"><span lang="es">Cómo llegar</span><span lang="en">Directions</span></a>
    </div>
  </div>

  <!-- Cinta de especialidades: decorativa y en movimiento; el lector de pantalla lee la lista una sola vez. -->
  <p class="sr-only"><span lang="es">Especialidades: {ESPECIALIDADES.map((e) => e.es).join(', ')}.</span><span lang="en">Specialties: {ESPECIALIDADES.map((e) => e.en).join(', ')}.</span></p>
  <div class="cinta-marco aparece mt-10 sm:mt-12" style="--d:840">
  <div class="cinta" aria-hidden="true">
    <div class="cinta-pista">
      {[0, 1].map(() => (
        <ul class="cinta-grupo">
          {vuelta.map((e) => <li><span lang="es">{e.es}</span><span lang="en">{e.en}</span></li>)}
        </ul>
      ))}
    </div>
  </div>
  <!-- La cinta, la ola y el destello se mueven sin fin: este botón los detiene (WCAG 2.2.2). -->
  <button id="portada-pausa" type="button" class="cinta-pausa presionable" aria-pressed="false">
    <svg class="i-pausa" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2" /><rect x="13.9" y="5" width="3.6" height="14" rx="1.2" /></svg>
    <svg class="i-seguir" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.86l10.2-6.4a1 1 0 0 0 0-1.72L9.5 4.74A1 1 0 0 0 8 5.6Z" /></svg>
    <span class="sr-only"><span lang="es">Pausar las animaciones de la portada</span><span lang="en">Pause the front-page animations</span></span>
  </button>
  </div>

  <div class="hero-media mt-8 sm:mt-10">
    <div class="hero-marco relative mx-auto aspect-[5/6] max-w-[90rem] overflow-hidden bg-pizarra sm:aspect-[16/8]">
      <img src={f.src} srcset={f.srcset} sizes="(min-width: 90rem) 90rem, 92vw" width={f.w} height={f.h} alt="Fachada de MAKIZEN Sushi & Mariscos en Blvd. Freemont, Puerto Peñasco" fetchpriority="high" decoding="async" class="hero-foto absolute inset-0 h-full w-full object-cover object-[46%_55%]" />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-noche/70 to-transparent"></div>
      <p class="absolute bottom-4 left-5 font-alt text-[11px] tracking-[0.2em] text-hueso/85 uppercase sm:left-8">Blvd. Freemont · Las Conchas</p>
      <p class="ichigo absolute top-5 right-4 sm:top-8 sm:right-8" lang="ja" title="一期一会 · Ichigo ichie" aria-hidden="true">一期一会</p>
    </div>
  </div>

  <!-- Hoy en MAKIZEN: reloj ensō (el círculo de pincel del logo como carátula de 12 h; el
       servicio de hoy en oro, de la 1 a las 10, y el punto de oro en la hora actual) junto a
       la ubicación y el servicio a domicilio. Lo pinta src/scripts/estado.ts. -->
  <div class="contenedor mt-8">
    <div class="hoy-mk revela" style="--i:0">
      <a href="#visita" class="hoy-reloj presionable" aria-describedby="hoy-estado">
        <svg class="hoy-svg" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <circle class="hoy-fondo" cx="60" cy="60" r="48" pathLength="360" />
          {Array.from({ length: 12 }, (_, i) => (
            <line class:list={['hoy-marca', i % 3 === 0 && 'mayor']} x1="60" y1={i % 3 === 0 ? 4 : 6} x2="60" y2="10" transform={`rotate(${i * 30} 60 60)`} />
          ))}
          <circle class="hoy-arco" cx="60" cy="60" r="48" pathLength="360" />
          <circle class="hoy-eco" cx="60" cy="60" r="42" pathLength="360" />
          <g class="hoy-aguja"><circle class="hoy-halo" cx="60" cy="12" r="9" /><circle class="hoy-punto" cx="60" cy="12" r="5" /></g>
        </svg>
        <span class="hoy-centro">
          <span class="hoy-ceja"><span lang="es">Hoy</span><span lang="en">Today</span></span>
          <span data-hoy class="hoy-horas">—</span>
        </span>
        <span class="sr-only"><span lang="es">Ver horario completo</span><span lang="en">See full hours</span></span>
      </a>
      <div class="hoy-datos">
        <p id="hoy-estado" data-hoy-estado class="hoy-estado"><span class="hoy-led" aria-hidden="true"></span><span class="texto">&nbsp;</span></p>
        <a href={n.mapa} target="_blank" rel="noopener" class="hoy-enlace presionable">
          <span class="hoy-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg></span>
          <span class="hoy-txt"><b>Las Conchas</b><small><span lang="es">Blvd. Freemont · Cómo llegar</span><span lang="en">Blvd. Freemont · Directions</span></small></span>
          <span class="hoy-flecha" aria-hidden="true">→</span>
        </a>
        <a href={`tel:${n.telefonoFijo}`} class="hoy-enlace presionable">
          <span class="hoy-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="2.6" /><circle cx="18.5" cy="17" r="2.6" /><path d="M8.6 17h7.3M14 7h3l2.6 7.4M5 12h6.5l2.5 5" /><path d="M3 9h5" /></svg></span>
          <span class="hoy-txt"><b><span lang="es">A domicilio</span><span lang="en">Delivery</span></b><small>{n.telefonoFijoTexto} · <span lang="es">Llamar</span><span lang="en">Call</span></small></span>
          <span class="hoy-flecha" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Teléfono en horizontal (poca altura): el logotipo y la foto caben en la pantalla
     y el titular asoma sin tener que desplazar tanto. */
  @media (orientation: landscape) and (max-height: 32rem) {
    .hero-cont { padding-top: 0.75rem; }
    .marca-hero { width: min(300px, 40vw); }
    .titular { font-size: clamp(2.4rem, 19svh, 6.8rem); }
    .hero-marco { aspect-ratio: auto; height: 82svh; }
  }
</style>
