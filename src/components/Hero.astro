---
// Portada editorial: titular grande, una sola foto real que entra y se abre a
// pantalla completa al hacer scroll, y los datos que la gente busca primero.
import { menu } from '../data/schema';
import { foto } from '../data/fotos-reales';

const n = menu.negocio;
const f = foto('mesa-cenital');
---
<section id="inicio" class="relative pt-[calc(4rem+env(safe-area-inset-top))]" aria-labelledby="t-inicio">
  <div class="contenedor pt-7 sm:pt-14">
    <p data-estado-local class="aparece inline-flex min-h-10 items-center gap-2.5 rounded-full bg-pizarra px-4 text-[14px] ring-1 ring-white/[0.07]" style="--d:120" aria-live="polite">
      <span class="punto relative size-2 rounded-full text-abierto" style="background:currentColor"></span>
      <span class="texto"><span lang="es">Lun, Mié, Jue 1–9 pm · Vie a Dom 1–10 pm</span><span lang="en">Mon, Wed, Thu 1–9 pm · Fri–Sun 1–10 pm</span></span>
    </p>

    <h1 id="t-inicio" class="mt-6 text-[clamp(2.7rem,12.4vw,6.8rem)] leading-[0.98] font-semibold tracking-[-0.04em]">
      <span class="linea"><span style="--d:180"><span lang="es">Sushi &amp; mariscos</span><span lang="en">Sushi &amp; seafood</span></span></span>
      <span class="linea"><span style="--d:300"><span lang="es">estilo <em class="text-oro-claro not-italic">Sinaloa.</em></span><span lang="en"><em class="text-oro-claro not-italic">Sinaloa</em> style.</span></span></span>
    </h1>
    <p class="aparece mt-5 max-w-[30rem] text-[17px] leading-relaxed text-niebla" style="--d:520">
      <span lang="es">Rollos, aguachiles y tostadas con sazón de Culiacán, en Puerto Peñasco, Sonora.</span>
      <span lang="en">Rolls, aguachiles and tostadas with Culiacán flavor, in Puerto Peñasco (Rocky Point), Sonora.</span>
    </p>
    <div class="aparece mt-7 flex flex-wrap gap-3" style="--d:640">
      <a href="#menu" class="boton-oro presionable">
        <span lang="es">Ver el menú</span><span lang="en">See the menu</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
      <a href={n.mapa} target="_blank" rel="noopener" class="boton-linea presionable"><span lang="es">Cómo llegar</span><span lang="en">Directions</span></a>
    </div>
  </div>

  <div class="hero-media mt-10 sm:mt-14">
    <div class="hero-marco relative mx-auto aspect-[4/5] max-w-[90rem] overflow-hidden bg-pizarra sm:aspect-[16/8]">
      <img src={f.src} srcset={f.srcset} sizes="100vw" width={f.w} height={f.h} alt="Mesa con platillos de MAKIZEN: sashimi, rollos, gin de pepino y entradas" fetchpriority="high" decoding="async" class="hero-foto absolute inset-0 h-full w-full object-cover" />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-noche/70 to-transparent"></div>
      <p class="absolute bottom-4 left-5 font-alt text-[11px] tracking-[0.2em] text-hueso/80 uppercase sm:left-8">@makizen.puertopenasco</p>
    </div>
  </div>

  <ul class="contenedor mt-6 grid grid-cols-3 gap-2 sm:gap-3">
    <li class="revela" style="--i:0">
      <a href="#visita" class="presionable flex h-full flex-col gap-1 rounded-2xl bg-pizarra p-3.5 ring-1 ring-white/[0.06] hover:ring-oro/50">
        <span class="ceja !text-[10px] !tracking-[0.18em]"><span lang="es">Hoy</span><span lang="en">Today</span></span>
        <span data-hoy class="text-[14px] leading-snug font-semibold">—</span>
      </a>
    </li>
    <li class="revela" style="--i:1">
      <a href={n.mapa} target="_blank" rel="noopener" class="presionable flex h-full flex-col gap-1 rounded-2xl bg-pizarra p-3.5 ring-1 ring-white/[0.06] hover:ring-oro/50">
        <span class="ceja !text-[10px] !tracking-[0.18em]"><span lang="es">Dónde</span><span lang="en">Where</span></span>
        <span class="text-[14px] leading-snug font-semibold">Las Conchas</span>
      </a>
    </li>
    <li class="revela" style="--i:2">
      <a href={`tel:${n.telefonoFijo}`} class="presionable flex h-full flex-col gap-1 rounded-2xl bg-pizarra p-3.5 ring-1 ring-white/[0.06] hover:ring-oro/50">
        <span class="ceja !text-[10px] !tracking-[0.18em]"><span lang="es">A domicilio</span><span lang="en">Delivery</span></span>
        <span class="text-[14px] leading-snug font-semibold whitespace-nowrap">{n.telefonoFijoTexto.replace('(638) ', '')}</span>
      </a>
    </li>
  </ul>
</section>
