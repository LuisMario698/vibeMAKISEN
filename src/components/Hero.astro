---
// Portada a pantalla completa con fotos reales del lugar y sus platillos,
// en formato de historias (barras de progreso, tocar a los lados para cambiar).
import Idioma from './Idioma.astro';
import { menu } from '../data/schema';
import { foto, portadaHero } from '../data/fotos-reales';

const n = menu.negocio;
const encuadre: Record<string, string> = {
  'mesa-cenital': '50% 40%',
  'fachada-atardecer': '78% 50%',
  'muro-logo': '50% 30%',
  'rollos-corona': '50% 50%',
};
// Cada letra cae por separado, pero las palabras no se cortan al final del renglón.
const letras = (t: string, d: number) => {
  let l = 0;
  return t.split(' ').map((w) => `<span class="inline-block whitespace-nowrap">${[...w].map((ch) => `<span class="letra" style="--l:${l++};--d:${d}">${ch}</span>`).join('')}</span>`).join(' ');
};
---
<header id="inicio" class="hero relative isolate h-[100svh] min-h-[640px] overflow-hidden" aria-label="MAKIZEN Sushi & Mariscos">
  <div class="hero-fondo absolute inset-0 -z-10" aria-hidden="true">
    {portadaHero.map((id, i) => {
      const f = foto(id);
      return (
        <img src={f.src} width={f.w} height={f.h} alt="" class:list={['historia', i === 0 && 'activa']} style={`object-position:${encuadre[id] ?? '50% 50%'}`}
          loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
      );
    })}
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.7)_0%,rgb(0_0_0/0.15)_22%,rgb(0_0_0/0.25)_42%,rgb(0_0_0/0.88)_72%,#000_100%)]"></div>
  </div>

  <div class="relative z-10 px-3 pt-[max(0.6rem,env(safe-area-inset-top))]">
    <div class="flex gap-1.5" aria-hidden="true">
      {portadaHero.map((_, i) => <span class:list={['barra-h', i === 0 && 'activa']}><i></i></span>)}
    </div>
    <div class="mt-3 flex items-center justify-between gap-3 px-1">
      <p class="entra flex items-center gap-2.5" style="--d:200">
        <img src="/brand/logo-isotipo.png" width="32" height="32" alt="" class="size-8 rounded-full ring-1 ring-oro/40" />
        <span class="leading-tight">
          <span class="block text-[14px] font-semibold">makizen.puertopenasco</span>
          <span class="block font-alt text-[10px] tracking-[0.14em] whitespace-nowrap text-oro uppercase">Puerto Peñasco · Sonora</span>
        </span>
      </p>
      <Idioma class="entra" />
    </div>
  </div>

  <!-- Zonas para cambiar de foto (como en Instagram) -->
  <button type="button" data-historia="-1" class="absolute top-24 left-0 z-10 h-[38%] w-1/3" aria-label="Foto anterior / Previous photo"></button>
  <button type="button" data-historia="1" class="absolute top-24 right-0 z-10 h-[38%] w-1/3" aria-label="Foto siguiente / Next photo"></button>

  <div class="hero-desvanece absolute inset-x-0 bottom-0 z-10 flex flex-col items-center px-5 pb-[max(5.5rem,calc(env(safe-area-inset-bottom)+5rem))] text-center">
    <h1 class="sr-only">MAKIZEN Sushi &amp; Mariscos</h1>
    <img src="/brand/logo-vertical.webp" width="520" height="597" alt="" class="logo-pintado h-auto w-[min(44vw,190px)] drop-shadow-[0_10px_30px_rgb(0_0_0/0.8)]" fetchpriority="high" />
    <p class="mt-5 font-alt text-[13px] tracking-[0.26em] text-hueso uppercase">
      <span class="sr-only"><span lang="es">{n.lema.es}</span><span lang="en">{n.lema.en}</span></span>
      <span aria-hidden="true"><span lang="es" set:html={letras(n.lema.es, 900)} /><span lang="en" set:html={letras(n.lema.en, 900)} /></span>
    </p>
    <p data-estado-local class="entra mt-4 inline-flex min-h-11 items-center gap-2.5 rounded-full border border-white/15 bg-noche/55 px-4 text-[15px] backdrop-blur-md" style="--d:1300" aria-live="polite">
      <span class="punto pulso relative size-2.5 rounded-full text-abierto" style="background:currentColor"></span>
      <span class="texto"><span lang="es">Lun, Mié, Jue 1–9 pm · Vie a Dom 1–10 pm</span><span lang="en">Mon, Wed, Thu 1–9 pm · Fri–Sun 1–10 pm</span></span>
    </p>
    <nav class="entra mt-4 grid w-full max-w-sm grid-cols-3 gap-2" style="--d:1450" aria-label="Contacto">
      <a href="#menu" class="presionable tap col-span-3 flex items-center justify-center gap-2 rounded-full bg-oro py-3 text-[16px] font-semibold text-noche hover:bg-oro-claro">
        <span lang="es">Ver el menú</span><span lang="en">See the menu</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
      <a href={`tel:${n.telefono}`} class="presionable tap flex items-center justify-center gap-1.5 rounded-full border border-white/20 bg-noche/45 py-2.5 text-[14px] backdrop-blur-md hover:border-oro">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-oro-claro)" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        <span lang="es">Llamar</span><span lang="en">Call</span>
      </a>
      <a href={n.mapa} target="_blank" rel="noopener" class="presionable tap flex items-center justify-center gap-1.5 rounded-full border border-white/20 bg-noche/45 py-2.5 text-[14px] backdrop-blur-md hover:border-oro">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-oro-claro)" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        <span lang="es">Llegar</span><span lang="en">Map</span>
      </a>
      <a href={n.instagram} target="_blank" rel="noopener" class="presionable tap flex items-center justify-center gap-1.5 rounded-full border border-white/20 bg-noche/45 py-2.5 text-[14px] backdrop-blur-md hover:border-oro">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-oro-claro)" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".8" fill="var(--color-oro-claro)" /></svg>
        Insta
      </a>
    </nav>
  </div>
</header>
