---
// Detalle del platillo: hoja inferior. El contenido lo llena src/scripts/app.ts.
---
<dialog id="hoja" class="hoja" aria-labelledby="hoja-titulo">
  <div class="hoja-panel relative max-h-[92svh] overflow-y-auto overscroll-contain rounded-t-[28px] border-t border-oro/50 bg-carbon pb-[max(1.5rem,env(safe-area-inset-bottom))] shadow-[0_-30px_60px_rgb(0_0_0/0.8)]">
    <div class="asa sticky top-0 z-10 flex touch-none items-center justify-between bg-gradient-to-b from-carbon via-carbon/90 to-transparent px-3 pt-2 pb-1">
      <span class="w-11"></span>
      <span class="h-1.5 w-12 rounded-full bg-white/30" aria-hidden="true"></span>
      <button type="button" data-cerrar class="presionable tap grid place-items-center rounded-full text-niebla hover:text-hueso" aria-label="Cerrar / Close">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="hoja-foto relative -mt-4 grid h-64 place-items-center bg-[radial-gradient(circle_at_50%_60%,rgb(174_139_61/0.32),transparent_60%)]">
      <img id="hoja-img" alt="" class="h-auto max-h-[232px] w-auto max-w-[88%] drop-shadow-[0_26px_26px_rgb(0_0_0/0.9)]" />
    </div>
    <div id="hoja-cuerpo" class="hoja-escalonada px-5"></div>
  </div>
</dialog>
