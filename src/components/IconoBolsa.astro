---
// Icono de «Mi pedido»: carrito de compras con el punto de oro del logo dentro de la
// canasta. El borde superior de la canasta (.bolsa-tapa) se levanta sobre su esquina
// izquierda para «recibir» un platillo (src/scripts/bolsa.ts). El mismo trazo se usa en la
// barra superior, la isla y el botón «Agregar».
interface Props { tam?: number; grueso?: number; class?: string }
const { tam = 22, grueso = 2, class: clase = '' } = Astro.props;
---
<svg class:list={['bolsa-ico', clase]} viewBox="0 0 24 24" width={tam} height={tam} fill="none" stroke="currentColor" stroke-width={grueso} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <g class="bolsa-cuerpo">
    <path d="M2.6 3.6h2.2l2.5 11.5a1.7 1.7 0 0 0 1.7 1.3h8.3a1.7 1.7 0 0 0 1.6-1.2l1.6-6.4" />
    <circle cx="9.6" cy="20" r="1.45" />
    <circle cx="17.2" cy="20" r="1.45" />
    <circle cx="13.5" cy="11.9" r="1.35" fill="currentColor" stroke="none" />
  </g>
  <g class="bolsa-tapa">
    <path d="M5.9 8.3h15.2" />
  </g>
</svg>
