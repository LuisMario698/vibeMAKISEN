---
// Selector ES | EN con pastilla que se desliza. `sobreOro`: versión para la isla dorada.
interface Props { class?: string; sobreOro?: boolean }
const { class: clase = '', sobreOro = false } = Astro.props;
---
<div class:list={['idioma relative grid grid-cols-2 rounded-full p-0.5 text-[14px] font-semibold', sobreOro ? 'bg-noche/15' : 'border border-white/20 bg-noche/60 backdrop-blur', clase]} role="group" aria-label="Idioma / Language">
  <span class:list={['pointer-events-none absolute inset-y-0.5 left-0.5 w-[calc(50%-2px)] rounded-full transition-transform duration-500 ease-resorte [html[lang=en]_&]:translate-x-full', sobreOro ? 'bg-noche' : 'bg-oro']} aria-hidden="true"></span>
  <button type="button" data-lang="es" class:list={['presionable tap relative z-10 rounded-full px-3', sobreOro ? 'text-noche/70 [html[lang^=es]_&]:text-oro-claro' : 'text-niebla [html[lang^=es]_&]:text-noche']} aria-pressed="true">ES</button>
  <button type="button" data-lang="en" class:list={['presionable tap relative z-10 rounded-full px-3', sobreOro ? 'text-noche/70 [html[lang=en]_&]:text-oro-claro' : 'text-niebla [html[lang=en]_&]:text-noche']} aria-pressed="false">EN</button>
</div>
