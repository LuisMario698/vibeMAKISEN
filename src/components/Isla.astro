---
import miniJson from '../data/miniaturas.json';
const conMini = new Set(Object.entries((miniJson as unknown as { recortes: Record<string, { anchos: number[] }> }).recortes).filter(([, v]) => v.anchos.includes(240)).map(([k]) => k));
const miniUrl = (id: string) => (conMini.has(id) ? `/menu/v/${id}-240.webp` : `/menu/${id}.webp`);
// Barra flotante del menú (la «isla»): tres controles separados, oro sobre mármol.
//   [ 01 Sección actual ▾ ]  ·  ( Buscar )  ·  [ Mi pedido · 3 ]
// Cada uno abre lo suyo: el selector de categorías, la búsqueda o el panel del pedido.
// Teléfono: los paneles suben como hoja; computadora: popover anclado sobre la barra.
// Todo el movimiento es transform/opacity (src/styles/isla.css); la lógica, src/scripts/isla.ts.
import Idioma from './Idioma.astro';
import IconoBolsa from './IconoBolsa.astro';
import EnsoMini from './EnsoMini.astro';
import { menu } from '../data/schema';
import '../styles/detalle.css';
import '../styles/isla.css';
import { iconoDe } from '../lib/iconos-categoria';

const grupos = [
  { id: 'comida', es: 'Comida', en: 'Food' },
  { id: 'bebidas', es: 'Bebidas', en: 'Drinks' },
] as const;
const miniatura = (c: (typeof menu.categorias)[number]) => c.platillos.find((p) => p.foto)?.foto;
const primera = menu.categorias[0]!;
---
<div id="isla-velo" class="isla-velo" aria-hidden="true"></div>
<div id="isla" class="isla" data-estado="oculta" data-lista="no">
  <div class="isla-barra">
    <!-- 1 · Sección actual: abre el selector de categorías. Deslizar cambia a la vecina. -->
    <button type="button" class="isla-pildora isla-ctl presionable" aria-expanded="false" aria-controls="isla-panel" aria-haspopup="dialog" style="--k:0" inert>
      <span class="num tabular-nums" aria-hidden="true">01</span>
      <span class="isla-texto"><span class="sr-only"><span lang="es">Sección actual:</span><span lang="en">Current section:</span> </span><span class="actual"><span lang="es">{primera.nombre.es}</span><span lang="en">{primera.nombre.en}</span></span></span>
      <svg class="flecha" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9.5 6 6 6-6" /></svg>
      <span class="avance" aria-hidden="true"></span>
    </button>

    <!-- 2 · Buscar: abre la búsqueda con el teclado listo. -->
    <button type="button" class="isla-lupa isla-ctl presionable" aria-expanded="false" aria-controls="isla-busca" aria-haspopup="dialog" style="--k:1" inert>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <span class="sr-only"><span lang="es">Buscar en el menú</span><span lang="en">Search the menu</span></span>
    </button>

    <!-- 3 · WhatsApp directo con el restaurante (Mi pedido vive en la barra superior). -->
    <a class="isla-wa isla-ctl presionable" href={`https://wa.me/${menu.negocio.whatsapp}?text=${encodeURIComponent('Hola MAKIZEN 👋 Vi su menú digital y quiero hacer un pedido.')}`} target="_blank" rel="noopener" style="--k:2" inert>
      <svg class="isla-wa-ico" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
      <span class="isla-rotulo" aria-hidden="true">WhatsApp</span>
      <span class="sr-only"><span lang="es">Escribir a MAKIZEN por WhatsApp</span><span lang="en">Message MAKIZEN on WhatsApp</span></span>
    </a>
  </div>

  <!-- Selector de categorías -->
  <div id="isla-panel" class="isla-hoja" role="dialog" aria-modal="true" aria-labelledby="isla-t-cats" inert>
    <div class="isla-cabeza">
      <span class="isla-asa" aria-hidden="true"></span>
      <h2 id="isla-t-cats" class="rotulo flex-1 text-[15px] font-semibold"><span lang="es">Secciones del menú</span><span lang="en">Menu sections</span></h2>
      <Idioma sobreOro />
      <button type="button" data-isla-cerrar class="presionable tap grid place-items-center rounded-full" aria-label="Cerrar / Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="isla-scroll">
      <div class="isla-cats">
        {grupos.map((g) => (
          <section>
            <h3 class="isla-grupo"><span lang="es">{g.es}</span><span lang="en">{g.en}</span></h3>
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {menu.categorias.map((c, i) => ({ c, i })).filter(({ c }) => c.grupo === g.id).map(({ c, i }) => {
                const m = miniatura(c);
                return (
                  <li class="isla-item">
                    <button type="button" data-ir={c.id} aria-current="false" class="isla-cat presionable">
                      <span class="miniatura">
                        {m ? <img src={miniUrl(m)} alt="" width="40" height="40" loading="lazy" decoding="async" /> : <img src={iconoDe(c.id)} alt="" width="30" height="30" loading="lazy" decoding="async" class="icono" />}
                      </span>
                      <span class="min-w-0 text-left">
                        <span class="line-clamp-2 block text-[13.5px] leading-[1.2] font-semibold"><span lang="es">{c.nombre.es}</span><span lang="en">{c.nombre.en}</span></span>
                        <span class="isla-cuenta block text-[13px] tabular-nums"><span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>{c.platillos.length}<span class="sr-only"><span lang="es"> productos</span><span lang="en"> items</span></span></span>
                      </span>
                    </button>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
      <button type="button" data-como-pido class="isla-como presionable" aria-haspopup="dialog">
        <EnsoMini />
        <span lang="es">¿Cómo pido?</span><span lang="en">How to order?</span>
      </button>
      <p class="isla-nota"><span lang="es">Picante y crudo: etiquetas por confirmar con cocina.</span><span lang="en">Spicy and raw labels: pending kitchen confirmation.</span></p>
    </div>
  </div>

  <!-- Búsqueda -->
  <div id="isla-busca" class="isla-hoja isla-hoja-busca" role="dialog" aria-modal="true" aria-labelledby="isla-t-busca" inert>
    <div class="isla-cabeza">
      <span class="isla-asa" aria-hidden="true"></span>
      <h2 id="isla-t-busca" class="rotulo flex-1 text-[15px] font-semibold"><span lang="es">Buscar</span><span lang="en">Search</span></h2>
      <button type="button" data-isla-cerrar class="presionable tap grid place-items-center rounded-full" aria-label="Cerrar / Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <form role="search" class="relative mx-4 mt-1" onsubmit="return false">
      <svg class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <input id="buscar" type="search" inputmode="search" autocomplete="off" enterkeyhint="search" aria-label="Buscar en el menú" placeholder="Buscar…"
        class="h-12 w-full rounded-full border-0 bg-noche/12 pr-4 pl-10 text-[16px] font-medium text-noche placeholder:text-noche/75 focus:bg-noche/18 focus:outline-2 focus:outline-noche" />
    </form>
    <div class="isla-filtros mx-4 mt-2.5 flex gap-2 overflow-x-auto" role="group" aria-label="Filtros / Filters">
      <button type="button" data-filtro="favorito" aria-pressed="false" class="filtro presionable"><span lang="es">Favoritos</span><span lang="en">Favorites</span></button>
      <button type="button" data-filtro="sinPicante" aria-pressed="false" class="filtro presionable"><span lang="es">Sin picante</span><span lang="en">Not spicy</span></button>
      <button type="button" data-filtro="cocido" aria-pressed="false" class="filtro presionable"><span lang="es">Cocido</span><span lang="en">Cooked</span></button>
    </div>
    <div class="isla-scroll">
      <p class="isla-pista"><span lang="es">Escribe un platillo, ingrediente o bebida, o usa un filtro.</span><span lang="en">Type a dish, ingredient or drink, or use a filter.</span></p>
      <ul class="isla-resultados" hidden></ul>
      <p id="isla-estado" class="sr-only" aria-live="polite"></p>
      <p class="isla-vacio" hidden><span lang="es">Sin resultados. Prueba otra palabra o quita un filtro.</span><span lang="en">No matches. Try another word or remove a filter.</span></p>
    </div>
  </div>
</div>

<!-- Aviso al agregar: confirma qué se agregó y lleva a «Mi pedido» con un botón real. -->
<div id="aviso-agregado" class="aviso-agregado" hidden>
  <span class="aa-mini" aria-hidden="true"><img alt="" width="44" height="44" hidden /></span>
  <p class="aa-texto">
    <span class="aa-titulo">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" /></svg>
      <span lang="es">Agregado</span><span lang="en">Added</span>
    </span>
    <span class="aa-nombre"></span>
  </p>
  <button type="button" class="aa-ver presionable">
    <IconoBolsa tam={18} />
    <span lang="es">Ver pedido</span><span lang="en">View order</span>
  </button>
</div>
