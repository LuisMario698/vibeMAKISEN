---
const frase = ['Sushi & Mariscos', '✦', 'Estilo Sinaloa', '✦', '一期一会', '✦', 'Puerto Peñasco', '✦', 'Rocky Point', '✦'];
const fila = (clase: string) => (
  [0, 1].map(() => frase.map((t) => `<span class="${clase}">${t}</span>`).join(''))
).join('');
---
<div class="relative overflow-hidden border-y border-oro/25 bg-carbon py-3" aria-hidden="true">
  <div class="cinta gap-6 font-alt text-[15px] tracking-[0.3em] text-oro uppercase" set:html={fila('px-3 whitespace-nowrap')} />
  <div class="cinta inversa mt-2 gap-6 text-[30px] font-bold tracking-[0.06em] text-transparent uppercase [-webkit-text-stroke:1px_rgb(174_139_61/0.55)]" set:html={fila('px-3 whitespace-nowrap')} />
</div>
