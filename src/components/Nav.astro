---
import Idioma from './Idioma.astro';
import { menu } from '../data/schema';
import '../styles/detalle.css';
---
<header id="nav" class="nav fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top)]">
  <div class="contenedor flex h-16 items-center justify-between gap-3">
    <a href="#inicio" class="presionable flex min-h-11 items-center rounded-lg" aria-label="MAKIZEN Sushi & Mariscos — inicio">
      <img src="/brand/logo-horizontal.svg" width="891" height="349" alt="MAKIZEN Sushi & Mariscos" class="logo-nav h-10 w-auto" />
    </a>
    <div class="flex items-center gap-2">
      <!-- WhatsApp directo con el restaurante. «Mi pedido» vive en la barra flotante de abajo. -->
      <a class="nav-lista nav-wa presionable aparece" style="--d:80" target="_blank" rel="noopener"
        href={`https://wa.me/${menu.negocio.whatsapp}?text=${encodeURIComponent('Hola MAKIZEN 👋 Vi su menú digital y quiero hacer un pedido.')}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="nav-wa-ico"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.830 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.230-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
        <span class="hidden sm:inline">WhatsApp</span>
        <span class="sr-only"><span lang="es">Escribir a MAKIZEN por WhatsApp</span><span lang="en">Message MAKIZEN on WhatsApp</span></span>
      </a>
      <Idioma class="aparece" />
    </div>
  </div>
</header>
