---
import Idioma from './Idioma.astro';
import IconoBolsa from './IconoBolsa.astro';
import '../styles/detalle.css';
---
<header id="nav" class="nav fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top)]">
  <div class="contenedor flex h-16 items-center justify-between gap-3">
    <a href="#inicio" class="presionable flex min-h-11 items-center rounded-lg" aria-label="MAKIZEN Sushi & Mariscos — inicio">
      <img src="/brand/logo-horizontal.svg" width="891" height="349" alt="MAKIZEN Sushi & Mariscos" class="logo-nav h-10 w-auto" />
    </a>
    <div class="flex items-center gap-2">
      <button type="button" data-abrir-lista class="nav-lista bolsa-boton presionable aparece" style="--d:80" aria-label="Mi pedido / My order">
        <span class="bolsa-onda" aria-hidden="true"></span>
        <IconoBolsa tam={21} />
        <span class="hidden sm:inline"><span lang="es">Mi pedido</span><span lang="en">My order</span></span>
        <span data-contador-lista data-ocultar-cero aria-hidden="true" class="nav-contador tabular-nums" data-vista="0" data-antes="0" hidden>0</span>
      </button>
      <Idioma class="aparece" />
    </div>
  </div>
</header>
