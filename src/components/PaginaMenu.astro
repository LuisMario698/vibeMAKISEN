---
// Cuerpo del menú, compartido por / (español) y /en/ (inglés).
import Intro from './Intro.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Favoritos from './Favoritos.astro';
import Seccion from './Seccion.astro';
import Visita from './Visita.astro';
import Pie from './Pie.astro';
import Hoja from './Hoja.astro';
import Isla from './Isla.astro';
import Lista from './Lista.astro';
import Riel from './Riel.astro';
import { menu } from '../data/schema';
import fotos from '../data/fotos.json';
import mini from '../data/miniaturas.json';
import { foto, realDe } from '../data/fotos-reales';
import { iconoDe } from '../lib/iconos-categoria';
import { jsonSeguro } from '../lib/texto';

// Datos mínimos para el detalle, la búsqueda y Mi lista (se arman en el navegador).
const datos = {
  tc: menu.tipoCambioReferencia,
  tcFecha: menu.tipoCambioFecha,
  whatsapp: menu.negocio.whatsapp,
  telefonoFijo: menu.negocio.telefonoFijo,
  horario: menu.negocio.horario,
  fotos,
  mini: Object.entries((mini as unknown as { recortes: Record<string, { anchos: number[] }> }).recortes).filter(([, v]) => v.anchos.includes(240)).map(([k]) => k),
  reales: Object.fromEntries(Object.entries(realDe).map(([id, f]) => [id, foto(f)])),
  cats: menu.categorias.map((c) => ({ id: c.id, nombre: c.nombre })),
  platillos: menu.categorias.flatMap((c) => c.platillos.map((p) => ({ ...p, cat: c.nombre, catId: c.id }))),
  iconos: Object.fromEntries(menu.categorias.map((c) => [c.id, iconoDe(c.id)])),
};
const mesa = foto('mesa-madera');
const total = menu.categorias.reduce((n, c) => n + c.platillos.length, 0);
---
<Intro />
<a href="#menu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-oro focus:px-4 focus:py-2 focus:text-noche">
  <span lang="es">Ir al menú</span><span lang="en">Skip to menu</span>
</a>
<Nav />
<Hero />
<div id="centinela" class="h-px" aria-hidden="true"></div>
<Favoritos />
<main id="menu" class="scroll-mt-16 pt-28" aria-labelledby="t-menu">
  <div class="contenedor revela relative">
    <img src="/brand/isotipo.svg" width="579" height="599" alt="" aria-hidden="true" loading="lazy" class="marca-agua -top-10 right-0 w-40 sm:w-56" />
    <div class="greca mb-8 max-w-xs" aria-hidden="true"></div>
    <p class="ceja"><span lang="es">Menú</span><span lang="en">Menu</span></p>
    <h2 id="t-menu" class="mt-2 text-[34px] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[48px]">
      <span lang="es">La carta completa</span><span lang="en">The full menu</span>
    </h2>
    <p class="mt-3 max-w-md text-[16px] text-niebla">
      <span lang="es">{total} platillos y bebidas. Abre uno y toca «Agregar» para armar tu pedido; luego mándalo por WhatsApp.</span>
      <span lang="en">{total} dishes and drinks. Open one and tap “Add” to build your order, then send it on WhatsApp.</span>
    </p>
  </div>
  <figure class="contenedor cortina mt-8" aria-hidden="true">
    <div class="relative aspect-[16/10] overflow-hidden rounded-3xl bg-pizarra sm:aspect-[21/9]">
      <div class="paralaje absolute -inset-y-[8%] inset-x-0">
        <img src={mesa.src} srcset={mesa.srcset} sizes="(min-width: 72rem) 1120px, calc(100vw - 2rem)" width={mesa.w} height={mesa.h} alt="" loading="lazy" decoding="async" class="cortina-img h-full w-full object-cover" />
      </div>
    </div>
  </figure>
  <div class="carta">
    <Riel />
    <div class="min-w-0">
      {menu.categorias.map((cat, i) => <Seccion cat={cat} n={i + 1} />)}
    </div>
  </div>
</main>
<Visita />
<Pie />
<Isla />
<Hoja />
<Lista />
<script type="application/json" id="datos-menu" set:html={jsonSeguro(datos)} />
<script src="../scripts/app.ts"></script>
