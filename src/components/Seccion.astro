---
import type { Categoria } from '../data/schema';
import { menu } from '../data/schema';
import { etiquetasHTML, precio, usd } from '../lib/etiquetas';
import fotos from '../data/fotos.json';
import { foto, portadas } from '../data/fotos-reales';

interface Props { cat: Categoria; n: number; total: number }
const { cat, n, total } = Astro.props;
const tc = menu.tipoCambioReferencia;
const tam = fotos as unknown as Record<string, [number, number]>;
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const indice = (p: Categoria['platillos'][number]) =>
  norm([p.nombre.es, p.nombre.en, p.descripcion?.es ?? '', p.descripcion?.en ?? '', cat.nombre.es, cat.nombre.en].join(' '));
const portada = portadas[cat.id];
const fp = portada ? foto(portada.foto) : undefined;
const palabras = (t: string) => t.split(' ').map((w, i) => `<span class="pal"><span style="--w:${i}">${w}</span></span>`).join(' ');
---
<section id={cat.id} data-seccion={cat.id} class="seccion mx-auto max-w-5xl scroll-mt-4 px-4 pt-14" aria-labelledby={`t-${cat.id}`}>
  {portada && fp ? (
    <figure class="revela portada relative h-[52svh] max-h-[460px] min-h-[300px] overflow-hidden">
      <div class="portada-mov absolute inset-0">
        <img src={fp.src} width={fp.w} height={fp.h} alt="" loading="lazy" decoding="async" class="portada-img absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.25),transparent_35%,rgb(0_0_0/0.9))]"></div>
      <figcaption class="absolute inset-x-0 bottom-0 p-5">
        <p class="ceja" aria-hidden="true">{String(n).padStart(2, '0')} / {total}</p>
        <h2 id={`t-${cat.id}`} class="titulo-sec mt-1 text-[34px] leading-[1.02] font-bold sm:text-[44px]">
          <span lang="es" set:html={palabras(cat.nombre.es)} /><span lang="en" set:html={palabras(cat.nombre.en)} />
        </h2>
        <p class="mt-2 font-alt text-[13px] tracking-[0.16em] text-oro-claro uppercase"><span lang="es">{portada.lema.es}</span><span lang="en">{portada.lema.en}</span></p>
      </figcaption>
    </figure>
  ) : (
    <div class="revela cabecera">
      <p class="ceja" aria-hidden="true">{String(n).padStart(2, '0')} / {total}</p>
      <h2 id={`t-${cat.id}`} class="titulo-sec rotulo mt-1 text-[24px] leading-tight sm:text-[28px]">
        <span lang="es" set:html={palabras(cat.nombre.es)} /><span lang="en" set:html={palabras(cat.nombre.en)} />
      </h2>
      <div class="filete filete-sec mt-3"></div>
    </div>
  )}
  {cat.nota && <p class="mt-3 text-[15px] text-niebla"><span lang="es">{cat.nota.es}</span><span lang="en">{cat.nota.en}</span></p>}

  <ul class="mt-5 grid gap-x-6 gap-y-3 md:grid-cols-2">
    {cat.platillos.map((p, i) => {
      const t = p.foto ? tam[p.foto] : undefined;
      return p.foto && t ? (
        <li class="revela" style={`--i:${i}`} data-buscar={indice(p)}>
          <article class:list={['tarjeta inclinable group relative h-full overflow-hidden rounded-3xl border border-oro/25 bg-gradient-to-b from-pizarra to-carbon hover:border-oro/60', p.agotado && 'agotado grayscale opacity-60']}>
            <div class="relative grid h-48 place-items-center overflow-hidden bg-[radial-gradient(circle_at_50%_62%,rgb(174_139_61/0.28),transparent_62%)]">
              <div class="flota">
                <img src={`/menu/${p.foto}.webp`} width={t[0]} height={t[1]} alt="" loading="lazy" decoding="async" data-foto={p.id}
                  class="foto-platillo mx-auto h-auto max-h-[176px] w-auto max-w-[86%] drop-shadow-[0_22px_22px_rgb(0_0_0/0.85)]" />
              </div>
              {p.agotado && (
                <p class="absolute top-3 right-3 rounded-full bg-noche/80 px-3 py-1 text-[13px] font-semibold tracking-wider uppercase"><span lang="es">Agotado</span><span lang="en">Sold out</span></p>
              )}
            </div>
            <div class="px-4 pt-1 pb-4">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-[18px] leading-snug font-semibold">
                  <button type="button" data-abrir={p.id} aria-haspopup="dialog" class="text-left after:absolute after:inset-0 after:rounded-3xl after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-oro-claro">
                    <span lang="es">{p.nombre.es}</span><span lang="en">{p.nombre.en}</span>
                  </button>
                </h3>
                <p class:list={['shrink-0 text-right text-[18px] font-bold tabular-nums', p.agotado && 'line-through decoration-1']}>
                  {precio(p.precio)}
                  <span class="block text-[12px] font-normal text-humo" lang="en">{usd(p.precio, tc)}</span>
                </p>
              </div>
              {p.descripcion && <p class="mt-1 line-clamp-2 text-[15px] text-niebla"><span lang="es">{p.descripcion.es}</span><span lang="en">{p.descripcion.en}</span></p>}
              <ul class="mt-3 flex flex-wrap gap-1.5" set:html={etiquetasHTML(p)} />
            </div>
          </article>
        </li>
      ) : (
        <li class="revela" style={`--i:${i}`} data-buscar={indice(p)}>
          <article class:list={['fila relative border-b border-oro/25 py-3.5', p.agotado && 'agotado opacity-55']}>
            <div class="flex items-baseline gap-3">
              <h3 class="flex-1 text-[17px] leading-snug font-semibold">
                <button type="button" data-abrir={p.id} aria-haspopup="dialog" class="text-left after:absolute after:inset-0 after:rounded-lg after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-oro-claro">
                  <span lang="es">{p.nombre.es}</span><span lang="en">{p.nombre.en}</span>
                </button>
                {p.gramos && <span class="ml-1 text-[13px] font-normal text-humo">{p.gramos} g</span>}
              </h3>
              <p class:list={['shrink-0 text-right text-[17px] font-bold tabular-nums', p.agotado && 'line-through decoration-1']}>
                {precio(p.precio)}
                <span class="block text-[12px] font-normal text-humo" lang="en">{usd(p.precio, tc)}</span>
              </p>
            </div>
            {p.descripcion && <p class="mt-0.5 line-clamp-2 text-[15px] text-niebla"><span lang="es">{p.descripcion.es}</span><span lang="en">{p.descripcion.en}</span></p>}
            <ul class="mt-2 flex flex-wrap gap-1.5 empty:hidden" set:html={etiquetasHTML(p)} />
          </article>
        </li>
      );
    })}
  </ul>
</section>
