---
// Una categoría del menú: cabecera limpia, foto real opcional, rejilla de platillos
// con foto y lista para los que no tienen foto (como una carta impresa).
import type { Categoria } from '../data/schema';
import { menu } from '../data/schema';
import { etiquetasHTML, etiquetaCorta, precio, usd } from '../lib/etiquetas';
import fotos from '../data/fotos.json';
import { foto, portadas } from '../data/fotos-reales';

interface Props { cat: Categoria; n: number }
const { cat, n } = Astro.props;
const tc = menu.tipoCambioReferencia;
const tam = fotos as unknown as Record<string, [number, number]>;
const conFoto = cat.platillos.filter((p) => p.foto && tam[p.foto]);
const sinFoto = cat.platillos.filter((p) => !(p.foto && tam[p.foto]));
const portada = portadas[cat.id] ? foto(portadas[cat.id]!) : undefined;
const solo = conFoto.length === 1;
---
<section id={cat.id} data-seccion={cat.id} class="contenedor scroll-mt-20 pt-16" aria-labelledby={`t-${cat.id}`}>
  <header class="revela">
    <div class="flex items-baseline gap-3">
      <span class="font-alt text-[13px] font-medium text-oro-claro tabular-nums" aria-hidden="true">{String(n).padStart(2, '0')}</span>
      <h3 id={`t-${cat.id}`} class="titulo-sec text-[27px] leading-tight font-semibold tracking-[-0.025em] sm:text-[34px]">
        <span lang="es">{cat.nombre.es}</span><span lang="en">{cat.nombre.en}</span>
      </h3>
    </div>
    <div class="trazo mt-3 h-px bg-gradient-to-r from-oro/70 via-hueso/10 to-transparent"></div>
    {cat.nota && <p class="mt-3 text-[15px] text-niebla"><span lang="es">{cat.nota.es}</span><span lang="en">{cat.nota.en}</span></p>}
  </header>

  {portada && (
    <figure class="cortina relative mt-6 aspect-[16/10] overflow-hidden rounded-3xl bg-pizarra sm:aspect-[21/8]" aria-hidden="true">
      <div class="paralaje absolute -inset-y-[8%] inset-x-0">
        <img src={portada.src} srcset={portada.srcset} sizes="(min-width: 1152px) 1120px, 100vw" width={portada.w} height={portada.h} alt="" loading="lazy" decoding="async" class="cortina-img h-full w-full object-cover" />
      </div>
    </figure>
  )}

  {conFoto.length > 0 && (
    <ul class:list={['mt-6 grid gap-x-3 gap-y-7', solo ? 'grid-cols-1' : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4']}>
      {conFoto.map((p, i) => {
        const t = tam[p.foto!]!;
        const corta = etiquetaCorta(p);
        return (
          <li class="revela" style={`--i:${i}`}>
            <article class:list={['producto group relative', solo && 'flex items-center gap-4', p.agotado && 'opacity-55 grayscale']} data-modo="recorte">
              <div class:list={['relative aspect-square shrink-0 overflow-hidden rounded-[22px] bg-pizarra ring-1 ring-white/[0.06]', solo && 'w-[42%] max-w-[220px]']}>
                <div class="absolute inset-0 bg-[radial-gradient(70%_55%_at_50%_60%,rgb(174_139_61/0.17),transparent_72%)]"></div>
                <img src={`/menu/${p.foto}.webp`} width={t[0]} height={t[1]} alt="" loading="lazy" decoding="async" data-foto={p.id}
                  class="producto-img absolute inset-0 m-auto h-[84%] w-[84%] object-contain drop-shadow-[0_18px_16px_rgb(0_0_0/0.75)]" />
                {p.agotado && <p class="absolute top-2.5 left-2.5 rounded-full bg-noche/85 px-2.5 py-1 text-[11px] font-semibold tracking-wider uppercase"><span lang="es">Agotado</span><span lang="en">Sold out</span></p>}
              </div>
              <div class:list={[solo ? 'min-w-0 flex-1' : 'mt-3 px-0.5']}>
                <h4 class="text-[15.5px] leading-snug font-semibold">
                  <button type="button" data-abrir={p.id} aria-haspopup="dialog" class="text-left after:absolute after:inset-0 after:rounded-[22px] after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-oro-claro">
                    <span lang="es">{p.nombre.es}</span><span lang="en">{p.nombre.en}</span>
                  </button>
                </h4>
                {solo && p.descripcion && <p class="mt-1 line-clamp-3 text-[14.5px] text-niebla"><span lang="es">{p.descripcion.es}</span><span lang="en">{p.descripcion.en}</span></p>}
                <div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                  <p class:list={['text-[15px] font-semibold text-hueso/90 tabular-nums', p.agotado && 'line-through']}>{precio(p.precio)}<span class="ml-1.5 text-[12px] font-normal text-humo" lang="en">{usd(p.precio, tc)}</span></p>
                  {corta && <span class="inline-flex items-center gap-1 text-[12px] text-niebla" set:html={corta} />}
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  )}

  {sinFoto.length > 0 && (
    <ul class:list={['grid sm:grid-cols-2 sm:gap-x-10', conFoto.length > 0 ? 'mt-6' : 'mt-3']}>
      {sinFoto.map((p, i) => (
        <li class="revela" style={`--i:${i}`}>
          <article class:list={['producto relative border-b border-hueso/[0.07] py-4', p.agotado && 'opacity-55']} data-modo="fila">
            <div class="flex items-baseline gap-3">
              <h4 class="flex-1 text-[16px] leading-snug font-semibold">
                <button type="button" data-abrir={p.id} aria-haspopup="dialog" class="text-left after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-oro-claro">
                  <span lang="es">{p.nombre.es}</span><span lang="en">{p.nombre.en}</span>
                </button>
                {p.gramos && <span class="ml-1.5 text-[13px] font-normal text-humo">{p.gramos} g</span>}
              </h4>
              <p class:list={['shrink-0 text-right text-[16px] font-semibold tabular-nums', p.agotado && 'line-through']}>
                {precio(p.precio)}
                <span class="block text-[12px] font-normal text-humo" lang="en">{usd(p.precio, tc)}</span>
              </p>
            </div>
            {p.descripcion && <p class="mt-1 line-clamp-2 text-[14.5px] text-niebla"><span lang="es">{p.descripcion.es}</span><span lang="en">{p.descripcion.en}</span></p>}
            <ul class="mt-2.5 flex flex-wrap gap-1.5 empty:hidden" set:html={etiquetasHTML(p)} />
          </article>
        </li>
      ))}
    </ul>
  )}
</section>
