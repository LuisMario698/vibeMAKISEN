---
// Telón de entrada: el isotipo se pinta como la pincelada de la luna y la cortina sube
// con borde curvo. Solo la primera visita de la sesión; tocar lo salta.
---
<div id="telon" class="telon" aria-hidden="true">
  <div class="grid justify-items-center gap-4">
    <img src="/brand/logo-isotipo.png" width="286" height="286" alt="" class="telon-iso" />
    <p class="telon-frase font-alt text-[13px] tracking-[0.6em] text-oro">一期一会</p>
  </div>
</div>
