---
// Visítanos: la fachada real al atardecer, dirección, horario y cómo llegar.
import { menu } from '../data/schema';
import { foto } from '../data/fotos-reales';
const n = menu.negocio;
const fachada = foto('fachada-frente');
const muro = foto('muro-logo');
const noche = foto('fachada-noche');
const dias = [
  { es: 'Domingo', en: 'Sunday' }, { es: 'Lunes', en: 'Monday' }, { es: 'Martes', en: 'Tuesday' },
  { es: 'Miércoles', en: 'Wednesday' }, { es: 'Jueves', en: 'Thursday' }, { es: 'Viernes', en: 'Friday' }, { es: 'Sábado', en: 'Saturday' },
];
const h12 = (t: string) => { const [h = 0, m = 0] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'am' : 'pm'}`; };
const orden = [1, 2, 3, 4, 5, 6, 0];
---
<section id="visita" class="pt-28" aria-labelledby="t-visita">
  <div class="contenedor revela">
    <p class="ceja"><span lang="es">Visítanos</span><span lang="en">Visit us</span></p>
    <h2 id="t-visita" class="mt-2 text-[34px] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[48px]">
      <span lang="es">Te esperamos en Las Conchas</span><span lang="en">See you at Las Conchas</span>
    </h2>
  </div>

  <div class="contenedor mt-8 grid gap-3 lg:grid-cols-[1.35fr_1fr]">
    <figure class="cortina relative aspect-[4/5] overflow-hidden rounded-3xl bg-pizarra lg:row-span-2 lg:aspect-auto">
      <div class="paralaje absolute -inset-y-[8%] inset-x-0">
        <img src={fachada.src} srcset={fachada.srcset} sizes="(min-width: 1024px) 640px, 100vw" width={fachada.w} height={fachada.h} alt="Fachada de MAKIZEN al atardecer, con el letrero encendido" loading="lazy" decoding="async" class="cortina-img h-full w-full object-cover" />
      </div>
      <figcaption class="absolute inset-x-3 bottom-3 rounded-2xl bg-grafito p-4 ring-1 ring-white/[0.06]">
        <p class="text-[16px] font-semibold">Blvd. Freemont y Blvd. Josefa Ortiz</p>
        <p class="mt-0.5 text-[14px] text-niebla"><span lang="es">Plaza de la gasolinera Las Conchas · Puerto Peñasco</span><span lang="en">Las Conchas gas station plaza · Puerto Peñasco</span></p>
        <div class="mt-3 flex gap-2">
          <a href={n.mapa} target="_blank" rel="noopener" class="boton-oro presionable min-h-11 flex-1 text-[15px]"><span lang="es">Cómo llegar</span><span lang="en">Directions</span></a>
          <a href={`tel:${n.telefono}`} class="boton-linea presionable min-h-11 flex-1 text-[15px]"><span lang="es">Llamar</span><span lang="en">Call</span></a>
        </div>
      </figcaption>
    </figure>

    <div class="revela rounded-3xl bg-pizarra p-5 ring-1 ring-white/[0.06]">
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-[17px] font-semibold"><span lang="es">Horario</span><span lang="en">Hours</span></h3>
        <p data-estado-local class="inline-flex items-center gap-2 text-[13px] text-niebla">
          <span class="punto relative size-2 rounded-full text-abierto" style="background:currentColor"></span><span class="texto"></span>
        </p>
      </div>
      <ul id="horario" class="mt-3 grid text-[15px]">
        {orden.map((d) => {
          const h = n.horario.find((x) => x.dia === d);
          return (
            <li data-dia={d} class="flex justify-between border-b border-hueso/[0.06] py-2.5 last:border-0 [&.hoy]:font-semibold [&.hoy]:text-oro-claro">
              <span><span lang="es">{dias[d]!.es}</span><span lang="en">{dias[d]!.en}</span></span>
              <span class="tabular-nums">{h ? `${h12(h.abre)} – ${h12(h.cierra)}` : <><span lang="es">Cerrado</span><span lang="en">Closed</span></>}</span>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-3">
      {[[muro, 'Muro con el logo de MAKIZEN iluminado'], [noche, 'Fachada de MAKIZEN de noche']].map(([f, alt], i) => (
        <figure class="cortina relative aspect-square overflow-hidden rounded-3xl bg-pizarra" style={`--i:${i + 1}`}>
          <img src={(f as typeof muro).src} srcset={(f as typeof muro).srcset} sizes="(min-width: 1024px) 240px, 50vw" width={(f as typeof muro).w} height={(f as typeof muro).h} alt={alt as string} loading="lazy" decoding="async" class="cortina-img h-full w-full object-cover" />
        </figure>
      ))}
    </div>
  </div>
</section>
