---
// Visítanos: fachada real al atardecer con parallax, galería del lugar y horario.
import { menu } from '../data/schema';
import { foto } from '../data/fotos-reales';
const n = menu.negocio;
const atardecer = foto('fachada-atardecer');
const galeria = [foto('fachada-dia'), foto('muro-logo'), foto('fachada-noche')];
const dias = [
  { es: 'Domingo', en: 'Sunday' }, { es: 'Lunes', en: 'Monday' }, { es: 'Martes', en: 'Tuesday' },
  { es: 'Miércoles', en: 'Wednesday' }, { es: 'Jueves', en: 'Thursday' }, { es: 'Viernes', en: 'Friday' }, { es: 'Sábado', en: 'Saturday' },
];
const h12 = (t: string) => { const [h = 0, m = 0] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'am' : 'pm'}`; };
const orden = [1, 2, 3, 4, 5, 6, 0];
const titulo = (t: string) => t.split(' ').map((w, i) => `<span class="pal"><span style="--w:${i}">${w}</span></span>`).join(' ');
---
<section id="visita" class="relative mt-24" aria-labelledby="t-visita">
  <div class="revela portada relative mx-4 h-[78svh] max-h-[680px] overflow-hidden">
    <div class="portada-mov absolute inset-0">
      <img src={atardecer.src} width={atardecer.w} height={atardecer.h} alt="Fachada de MAKIZEN al atardecer" loading="lazy" decoding="async" class="portada-img absolute inset-0 h-full w-full object-cover object-[70%_50%]" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_35%,rgb(0_0_0/0.92))]"></div>
    <div class="absolute inset-x-0 bottom-0 p-6">
      <p class="ceja"><span lang="es">Visítanos</span><span lang="en">Visit us</span></p>
      <h2 id="t-visita" class="mt-2 text-[32px] leading-[1.05] font-bold">
        <span lang="es" set:html={titulo('Te esperamos en Las Conchas')} /><span lang="en" set:html={titulo('See you at Las Conchas')} />
      </h2>
      <p class="mt-3 text-[15px] text-niebla">{n.direccion}, {n.ciudad}</p>
      <p data-estado-local class="mt-4 inline-flex min-h-11 items-center gap-2.5 rounded-full border border-white/15 bg-noche/55 px-4 text-[15px] backdrop-blur-md">
        <span class="punto relative size-2.5 rounded-full text-abierto" style="background:currentColor"></span>
        <span class="texto"></span>
      </p>
      <div class="mt-4 flex gap-2">
        <a href={n.mapa} target="_blank" rel="noopener" class="presionable tap flex flex-1 items-center justify-center rounded-full bg-oro px-4 text-[15px] font-semibold text-noche hover:bg-oro-claro"><span lang="es">Cómo llegar</span><span lang="en">Directions</span></a>
        <a href={`tel:${n.telefono}`} class="presionable tap flex flex-1 items-center justify-center rounded-full border border-white/25 px-4 text-[15px] font-semibold hover:border-oro"><span lang="es">Llamar</span><span lang="en">Call</span></a>
      </div>
    </div>
  </div>

  <ul class="mx-4 mt-3 grid grid-cols-3 gap-3">
    {galeria.map((f, i) => (
      <li class="revela portada relative aspect-[3/4] overflow-hidden" style={`--i:${i}`}>
        <img src={f.src} width={f.w} height={f.h} alt="" loading="lazy" decoding="async" class="portada-img absolute inset-0 h-full w-full object-cover" />
      </li>
    ))}
  </ul>

  <div class="revela mx-auto mt-10 max-w-xl px-4">
    <h3 class="rotulo text-[15px] text-oro"><span lang="es">Horario</span><span lang="en">Hours</span></h3>
    <div class="filete filete-sec mt-2"></div>
    <ul id="horario" class="mt-2 grid text-[16px]">
      {orden.map((d) => {
        const h = n.horario.find((x) => x.dia === d);
        return (
          <li data-dia={d} class="flex justify-between border-b border-white/10 py-3 transition-colors [&.hoy]:font-semibold [&.hoy]:text-oro-claro">
            <span><span lang="es">{dias[d]!.es}</span><span lang="en">{dias[d]!.en}</span></span>
            <span class="tabular-nums">{h ? `${h12(h.abre)} – ${h12(h.cierra)}` : <><span lang="es">Cerrado</span><span lang="en">Closed</span></>}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>
