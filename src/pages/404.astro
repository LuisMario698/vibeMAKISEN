---
import Base from '../layouts/Base.astro';
---
<Base idioma="es" titulo="Página no encontrada · MAKIZEN" noindex>
  <main class="contenedor grid min-h-[100svh] content-center justify-items-center gap-6 py-16 text-center">
    <img src="/brand/isotipo.svg" width="579" height="599" alt="" class="h-auto w-24 opacity-90" />
    <h1 class="text-[28px] leading-tight font-semibold"><span lang="es">Esta página no existe</span><span lang="en">This page doesn't exist</span></h1>
    <p class="max-w-sm text-[16px] text-niebla"><span lang="es">Puede que el enlace esté incompleto.</span><span lang="en">The link may be incomplete.</span></p>
    <a href="/" class="boton-oro presionable"><span lang="es">Ver el menú</span><span lang="en">See the menu</span></a>
  </main>
</Base>
