---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Favoritos from '../components/Favoritos.astro';
import Seccion from '../components/Seccion.astro';
import Visita from '../components/Visita.astro';
import Pie from '../components/Pie.astro';
import Hoja from '../components/Hoja.astro';
import Isla from '../components/Isla.astro';
import { menu } from '../data/schema';
import fotos from '../data/fotos.json';
import { foto, realDe } from '../data/fotos-reales';
import { iconoDe } from '../lib/iconos-categoria';

// Datos mínimos para la hoja de detalle y la búsqueda de la isla (se arman en el navegador).
const datos = {
  tc: menu.tipoCambioReferencia,
  horario: menu.negocio.horario,
  fotos,
  reales: Object.fromEntries(Object.entries(realDe).map(([id, f]) => [id, foto(f)])),
  cats: menu.categorias.map((c) => ({ id: c.id, nombre: c.nombre })),
  platillos: menu.categorias.flatMap((c) => c.platillos.map((p) => ({ ...p, cat: c.nombre, catId: c.id }))),
  iconos: Object.fromEntries(menu.categorias.map((c) => [c.id, iconoDe(c.id)])),
};
const mesa = foto('mesa-madera');
const total = menu.categorias.reduce((n, c) => n + c.platillos.length, 0);
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>MAKIZEN Sushi & Mariscos · Menú · Puerto Peñasco</title>
    <meta name="description" content="Menú de MAKIZEN Sushi & Mariscos, estilo Sinaloa, en Puerto Peñasco (Rocky Point), Sonora. Precios en MXN, en español e inglés." />
    <meta name="theme-color" content="#050505" />
    <!-- Demo / propuesta: no indexar para no competir en buscadores con el negocio real. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/brand/isotipo.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- PWA: registra el service worker generado por @vite-pwa/astro (menú disponible sin conexión). -->
    <script is:inline src="/registerSW.js" defer></script>
    <link rel="preload" as="image" href="/fotos/fachada-dia-1080.webp" imagesrcset="/fotos/fachada-dia-640.webp 640w, /fotos/fachada-dia-1080.webp 1080w, /fotos/fachada-dia-1600.webp 1600w" imagesizes="100vw" fetchpriority="high" />
    <script is:inline>
      // Idioma antes de pintar: el elegido o el del teléfono.
      (function () {
        var l = null;
        try { l = localStorage.getItem('makizen-idioma'); } catch (e) {}
        if (!l) l = (navigator.language || 'es').toLowerCase().indexOf('en') === 0 ? 'en' : 'es-MX';
        document.documentElement.lang = l === 'en' ? 'en' : 'es-MX';
      })();
    </script>
  </head>
  <body>
    <a href="#menu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-oro focus:px-4 focus:py-2 focus:text-noche">
      <span lang="es">Ir al menú</span><span lang="en">Skip to menu</span>
    </a>
    <Nav />
    <Hero />
    <div id="centinela" class="h-px" aria-hidden="true"></div>
    <Favoritos />
    <main id="menu" class="scroll-mt-16 pt-28" aria-labelledby="t-menu">
      <div class="contenedor revela">
        <p class="ceja"><span lang="es">Menú</span><span lang="en">Menu</span></p>
        <h2 id="t-menu" class="mt-2 text-[34px] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[48px]">
          <span lang="es">La carta completa</span><span lang="en">The full menu</span>
        </h2>
        <p class="mt-3 max-w-md text-[16px] text-niebla">
          <span lang="es">{total} platillos y bebidas. Usa la isla dorada de abajo para saltar entre categorías o buscar.</span>
          <span lang="en">{total} dishes and drinks. Use the golden island below to jump between categories or search.</span>
        </p>
      </div>
      <figure class="contenedor cortina mt-8" aria-hidden="true">
        <div class="relative aspect-[16/10] overflow-hidden rounded-3xl bg-pizarra sm:aspect-[21/9]">
          <div class="paralaje absolute -inset-y-[8%] inset-x-0">
            <img src={mesa.src} srcset={mesa.srcset} sizes="(min-width: 1152px) 1120px, 100vw" width={mesa.w} height={mesa.h} alt="" loading="lazy" decoding="async" class="cortina-img h-full w-full object-cover" />
          </div>
        </div>
      </figure>
      {menu.categorias.map((cat, i) => <Seccion cat={cat} n={i + 1} />)}
    </main>
    <Visita />
    <Pie />
    <Isla />
    <Hoja />
    <script type="application/json" id="datos-menu" set:html={JSON.stringify(datos)} />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
